// SPDX-License-Identifier: GPL-2.0
/*
 * Device tree for the Pocketbook Touch HD ebook reader
 *
 * Name on mainboard is: 37NB-E60QK0+4A2
 * Serials start with: 60QK2
 *
 */

/dts-v1/;

#include <dt-bindings/leds/common.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/gpio/gpio.h>
#include "imx6sl.dtsi"

/ {
	model = "PocketBook Touch HD (PB631)";
	compatible = "pocketbook,pb631", "fsl,imx6sl";

	aliases {
		mmc0 = &usdhc4;
		mmc1 = &usdhc2;
	};

	chosen {
		stdout-path = &uart1;
	};

	reserved-memory {
		#address-cells = <1>;
		#size-cells = <1>;
		ramoops@90000000 {
			compatible = "ramoops";
			reg = <0x90000000 0x00100000>;
			record-size = <0x1000>;
			console-size = <0x80000>;
			ftrace-size = <0x1000>;
			pmsg-size = <0x8000>;
		};
	};

	gpio_keys: gpio-keys {
		compatible = "gpio-keys";
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_gpio_keys>;

		key-menu {
			label = "Menu";
			gpios = <&gpio3 25 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_MENU>;
			wakeup-source;
		};

		key-home {
			label = "Home";
			gpios = <&gpio3 27 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_HOME>;
			wakeup-source;
		};

		key-backward {
			label = "Backward";
			gpios = <&gpio3 29 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_PAGEUP>;
			wakeup-source;
		};

		key-forward {
			label = "Forward";
			gpios = <&gpio3 31 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_PAGEDOWN>;
			wakeup-source;
		};

		key-power {
			label = "Power";
			gpios = <&gpio5 8 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_POWER>;
			wakeup-source;
		};

		key-cover {
			label = "Cover";
			gpios = <&gpio5 12 GPIO_ACTIVE_LOW>;
			linux,code = <SW_LID>;
			linux,input-type = <EV_SW>;
			wakeup-source;
		};
	};

	leds: leds {
		compatible = "gpio-leds";
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_leds>;

		on {
			label = "pocketbookpb631:green:on";
			gpios = <&gpio5 13 GPIO_ACTIVE_LOW>;
			linux,default-trigger = "timer";
		};
	};

	memory@80000000 {
		device_type = "memory";
		reg = <0x80000000 0x20000000>;
	};

	reg_wifi: regulator-wifi {
		compatible = "regulator-fixed";
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_wifi_power>;
		regulator-name = "SD3_SPWR";
		regulator-min-microvolt = <3000000>;
		regulator-max-microvolt = <3000000>;
		enable-active-high;
		gpio = <&gpio4 29 GPIO_ACTIVE_HIGH>;
	};
/*
	reg_adldo: regulator-adldo {
		compatible = "regulator-fixed";
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_codecldo_power>;
		regulator-name = "AD_LDO_ON";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		regulator-always-on;
		regulator-boot-on;
		gpio = <&gpio4 2 GPIO_ACTIVE_HIGH>;
	};
*/
	reg_ad1v8: regulator-ad1v8 {
		compatible = "regulator-fixed";
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_codec1v8_power>;
		regulator-name = "AD_1V8_ON";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		regulator-always-on;
		regulator-boot-on;
		enable-active-high;
		gpio = <&gpio4 0 GPIO_ACTIVE_HIGH>;
	};

	reg_ad3v3: regulator-ad3v3 {
		compatible = "regulator-fixed";
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_codec3v3_power>;
		regulator-name = "AD_3V3_ON";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-always-on;
		regulator-boot-on;
		gpio = <&gpio3 30 GPIO_ACTIVE_LOW>;
	};

	sound {
		compatible = "fsl,imx-audio-rt5640";
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_hp>;
		model = "imx-rt5640";
		ssi-controller = <&ssi1>; //ssi2?
		audio-codec = <&rt5640>;
		audio-routing =
			/* board Headphone Jack */
			"Headphone Jack", "HPOR",
			"Headphone Jack", "HPOL";
		mux-int-port = <2>;
		mux-ext-port = <3>;
		hp-det-gpios = <&gpio3 24 GPIO_ACTIVE_LOW>;
	};

	thermal-zones {
		epd-thermal {
			polling-delay = <10000>;
			polling-delay-passive = <10000>;
			thermal-sensors = <&tps6518x>;

			trips {
			};
		};
	};

	wifi_pwrseq: wifi_pwrseq {
		compatible = "mmc-pwrseq-simple";
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_wifi_reset>;
		post-power-on-delay-ms = <20>;
		reset-gpios = <&gpio5 0 GPIO_ACTIVE_LOW>;
	};
};

&audmux {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_audmux3>;
	status = "okay";
};

&gpu_2d {
	status = "disabled";
};

&gpu_vg {
	status = "disabled";
};

&epdc {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_epdc0>;
	safe-ticks-turnoff-ep3v3=<800>;
	V3P3-supply = <&V3P3_reg>;
	VCOM-supply = <&VCOM_reg>;
	DISPLAY-supply = <&DISPLAY_reg>;
	epd-thermal-zone = "epd-thermal";

	vscan-holdoff = <4>;
	sdoed-width = <10>;
	sdoed-delay = <20>;
	sdoez-width = <10>;
	sdoez-delay = <20>;
	gdclk-hp-offs = <562>;
	gdsp-offs = <662>;
	gdoe-offs = <0>;
	gdclk-offs = <225>;
	num-ce = <1>;

	status = "okay";

	timing {
		clock-frequency = <80000000>;
		hactive = <1448>;
		hback-porch = <16>;
		hfront-porch = <102>;
		hsync-len = <28>;
		vactive = <1072>;
		vback-porch = <4>;
		vfront-porch = <4>;
		vsync-len = <2>;
	};
};

&i2c1 {
	pinctrl-names = "default","sleep";
	pinctrl-0 = <&pinctrl_i2c1>;
	pinctrl-1 = <&pinctrl_i2c1_sleep>;
	i2c-scl-rising-time-ns = <300>;
	i2c-scl-falling-time-ns = <15>;
	status = "okay";

	lm3630a: backlight@36 {
		reg = <0x36>;
		compatible = "ti,lm3630a";
		enable-gpios = <&gpio2 10 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_backlight_power>;

		#address-cells = <1>;
		#size-cells = <0>;
		status = "okay";
		led@0 {
			reg = <0>;
			led-sources = <0>;
			label = "backlight";
			default-brightness = <127>;
			max-brightness = <255>;
		};
	};

	rt5640: rt5640@1c {
		compatible = "realtek,rt5640";
		reg = <0x1c>;
		/*interrupt-parent = <&gpio3>;
		interrupts = <24 IRQ_TYPE_LEVEL_LOW>;*/
		realtek,ldo1-en-gpios =
			<&gpio4 2 GPIO_ACTIVE_HIGH>;
		/*realtek,jack-detect-source = <1>;*/
		clocks = <&clks IMX6SL_CLK_EXTERN_AUDIO>;
	};
};

&i2c2 {
	pinctrl-names = "default","sleep";
	pinctrl-0 = <&pinctrl_i2c2>;
	pinctrl-1 = <&pinctrl_i2c2_sleep>;
	clock-frequency = <100000>;
	status = "okay";

	touchscreen@50 {
		compatible = "neonode,zforce";
		reg = <0x50>;
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_ts>;
		reset-gpios = <&gpio5 9 GPIO_ACTIVE_LOW>;
		interrupts-extended = <&gpio5 6 IRQ_TYPE_LEVEL_LOW>;
		vdd-supply = <&ldo1_reg>;
		touchscreen-min-x = <0>;
		touchscreen-size-x = <1072>;
		touchscreen-min-y = <0>;
		touchscreen-size-y = <1448>;
		touchscreen-swapped-x-y;
		touchscreen-inverted-x;
		status = "okay";
	};

	tps6518x: epdc-pmic@68 {
		compatible = "ti,tps6518x";
		reg = <0x68>;
		/*
		 * power sequencing for TPS65180/65181
		 */
		pwr_seq0 = <0xe1>; /* [Vddh-seq=3 | Vpos-seq=2 | Vee-seq=0 | Vneg-seq=1] */
		pwr_seq1 = <0x30>; /* [Vneg-dly1=3 |Vee-dly0=0]  mSec */
		pwr_seq2 = <0x33>; /* [Vddh-dly3=3 | Vpos-dly2=3] mSec */

                /*
                 * power sequencing for TPS65185/65186
                 */
                upseq0 = <0xe1>;
                upseq1 = <0x00>;
                dwnseq0 = <0x1e>;
                dwnseq1 = <0xe0>;

		pwrgood-gpios = <&gpio2 13 0>;
		vcom-ctrl-gpios = <&gpio2 3 GPIO_ACTIVE_HIGH>;
		wakeup-gpios = <&gpio2 7 0>;
		powerup-gpios = <&gpio2 8 GPIO_ACTIVE_HIGH>;
		intr-gpios = <&gpio2 9 0>;

		/* gpio_pmic_v3p3 = <&gpio2 14 GPIO_ACTIVE_HIGH>; */
		pwrall-gpios = <&gpio2 14 GPIO_ACTIVE_HIGH>;

		#thermal-sensor-cells = <0>;

		pinctrl-names = "default", "sleep";
		pinctrl-0 = <&pinctrl_tps65185_gpio>;
		pinctrl-1 = <&pinctrl_tps65185_gpio_sleep>;

		regulators {
			DISPLAY_reg: DISPLAY {
				regulator-name = "DISPLAY";
			};

			VCOM_reg: VCOM {
				regulator-name = "VCOM";
				regulator-max-microvolt = <2750000>;
				regulator-min-microvolt = <300000>;
			};

			V3P3_reg: V3P3 {
				regulator-name = "V3P3";
			};

		};
	};
};

&i2c3 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_i2c3>;
	clock-frequency = <400000>;
	status = "okay";

	ricoh619: pmic@32 {
		compatible = "ricoh,rc5t619";
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_ricoh_gpio>;
		reg = <0x32>;
		interrupt-parent = <&gpio5>;
		interrupts = <11 IRQ_TYPE_LEVEL_LOW>;
		system-power-controller;

		regulators {
			dcdc1_reg: DCDC1 {
				regulator-name = "DCDC1";
				regulator-min-microvolt = <300000>;
				regulator-max-microvolt = <1875000>;
				regulator-always-on;
				regulator-boot-on;

				regulator-state-mem {
					regulator-on-in-suspend;
					regulator-suspend-max-microvolt = <900000>;
					regulator-suspend-min-microvolt = <900000>;
				};
			};

			/* Core3_3V3 */
			dcdc2_reg: DCDC2 {
				regulator-name = "DCDC2";
				regulator-always-on;
				regulator-boot-on;

				regulator-state-mem {
					regulator-on-in-suspend;
					regulator-suspend-max-microvolt = <3300000>;
					regulator-suspend-min-microvolt = <3300000>;
				};
			};

			dcdc3_reg: DCDC3 {
				regulator-name = "DCDC3";
				regulator-min-microvolt = <300000>;
				regulator-max-microvolt = <1875000>;
				regulator-always-on;
				regulator-boot-on;

				regulator-state-mem {
					regulator-on-in-suspend;
					regulator-suspend-max-microvolt = <1140000>;
					regulator-suspend-min-microvolt = <1140000>;
				};
			};

			/* Core4_1V2 */
			dcdc4_reg: DCDC4 {
				regulator-name = "DCDC4";
				regulator-min-microvolt = <1200000>;
				regulator-max-microvolt = <1200000>;
				regulator-always-on;
				regulator-boot-on;

				regulator-state-mem {
					regulator-on-in-suspend;
					regulator-suspend-max-microvolt = <1140000>;
					regulator-suspend-min-microvolt = <1140000>;
				};
			};

			/* Core4_1V8 */
			dcdc5_reg: DCDC5 {
				regulator-name = "DCDC5";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-always-on;
				regulator-boot-on;

				regulator-state-mem {
					regulator-on-in-suspend;
					regulator-suspend-max-microvolt = <1700000>;
					regulator-suspend-min-microvolt = <1700000>;
				};
			};

			/* IR_3V3 */
			ldo1_reg: LDO1  {
				regulator-name = "LDO1";
				regulator-always-on;
				regulator-boot-on;
			};

			/* Core1_3V3 */
			ldo2_reg: LDO2  {
				regulator-name = "LDO2";
				regulator-always-on;
				regulator-boot-on;

				regulator-state-mem {
					regulator-on-in-suspend;
					regulator-suspend-max-microvolt = <3300000>;
					regulator-suspend-min-microvolt = <3300000>;
				};
			};

			/* Core5_1V2 */
			ldo3_reg: LDO3  {
				regulator-name = "LDO3";
				regulator-always-on;
				regulator-boot-on;
			};

			ldo4_reg: LDO4 {
				regulator-name = "LDO4";
				regulator-boot-on;
			};

			/* SPD_3V3 */
			ldo5_reg: LDO5 {
				regulator-name = "LDO5";
				regulator-always-on;
				regulator-boot-on;
			};

			/* DDR_0V6 */
			ldo6_reg: LDO6 {
				regulator-name = "LDO6";
				regulator-always-on;
				regulator-boot-on;
			};

			/* VDD_PWM */
			ldo7_reg: LDO7 {
				regulator-name = "LDO7";
				regulator-always-on;
				regulator-boot-on;
			};

			/* ldo_1v8 */
			ldo8_reg: LDO8 {
				regulator-name = "LDO8";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
			};

			ldo9_reg: LDO9 {
				regulator-name = "LDO9";
				regulator-boot-on;
			};

			ldo10_reg: LDO10 {
				regulator-name = "LDO10";
				regulator-boot-on;
			};

			ldortc1_reg: LDORTC1  {
				regulator-name = "LDORTC1";
				regulator-always-on;
				regulator-boot-on;
			};
		};
	};
};

&reg_vdd1p1 {
	vin-supply = <&dcdc2_reg>;
};

&reg_vdd2p5 {
	vin-supply = <&dcdc2_reg>;
};

&reg_arm {
	vin-supply = <&dcdc3_reg>;
};

&reg_soc {
	vin-supply = <&dcdc1_reg>;
};

&reg_pu {
	vin-supply = <&dcdc1_reg>;
};

&ssi1 {
	status = "okay";
};

&snvs_rtc {
	/*
	 * We are using the RTC in the PMIC, but this one is not disabled
	 * in imx6sl.dtsi.
	 */
	status = "disabled";
};

&uart1 {
	/* J4 */
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_uart1>;
	status = "okay";
};

&uart4 {
	/* J9 */
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_uart4>;
	status = "okay";
};

&usdhc2 {
	pinctrl-names = "default", "state_100mhz", "state_200mhz", "sleep";
	pinctrl-0 = <&pinctrl_usdhc2>;
	pinctrl-1 = <&pinctrl_usdhc2_100mhz>;
	pinctrl-2 = <&pinctrl_usdhc2_200mhz>;
	pinctrl-3 = <&pinctrl_usdhc2_sleep>;
	status = "okay";

	cd-gpios = <&gpio5 2 GPIO_ACTIVE_LOW>;

	/* external uSD card */
};

&usdhc3 {
	pinctrl-names = "default", "state_100mhz", "state_200mhz", "sleep";
	pinctrl-0 = <&pinctrl_usdhc3>;
	pinctrl-1 = <&pinctrl_usdhc3_100mhz>;
	pinctrl-2 = <&pinctrl_usdhc3_200mhz>;
	pinctrl-3 = <&pinctrl_usdhc3_sleep>;
	vmmc-supply = <&reg_wifi>;
	mmc-pwrseq = <&wifi_pwrseq>;
	cap-power-off-card;
	non-removable;
	status = "okay";

	/* Realtek RTL8189FTV SDIO WiFi */
};

&usdhc4 {
	pinctrl-names = "default", "state_100mhz", "state_200mhz", "sleep";
	pinctrl-0 = <&pinctrl_usdhc4>;
	pinctrl-1 = <&pinctrl_usdhc4_100mhz>;
	pinctrl-2 = <&pinctrl_usdhc4_200mhz>;
	pinctrl-3 = <&pinctrl_usdhc4_sleep>;
	status = "okay";
	non-removable;

	/* internal uSD card */
};

&usbotg1 {
	pinctrl-names = "default";
	disable-over-current;
	srp-disable;
	hnp-disable;
	adp-disable;
	status = "okay";
};

&iomuxc {
	pinctrl_audmux3: audmux3grp {
		fsl,pins = <
			MX6SL_PAD_AUD_MCLK__AUDIO_CLK_OUT 0x4130b0
			MX6SL_PAD_AUD_RXD__AUD3_RXD	  0x4130b0
			MX6SL_PAD_AUD_TXC__AUD3_TXC	  0x4130b0
			MX6SL_PAD_AUD_TXD__AUD3_TXD	  0x4110b0
			MX6SL_PAD_AUD_TXFS__AUD3_TXFS	  0x4130b0
		>;
	};

	pinctrl_backlight_power: backlight-powergrp {
		fsl,pins = <
			MX6SL_PAD_EPDC_PWRCTRL3__GPIO2_IO10 0x110B0
		>;
	};
/*
	pinctrl_codecldo_power: codec-powergrp {
		fsl,pins = <
			MX6SL_PAD_KEY_COL5__GPIO4_IO02 0x110B0
		>;
	};
*/
	pinctrl_codec1v8_power: codec1v8-powergrp {
		fsl,pins = <
			MX6SL_PAD_KEY_COL4__GPIO4_IO00 0x110B0
		>;
	};

	pinctrl_codec3v3_power: codec3v3-powergrp {
		fsl,pins = <
			MX6SL_PAD_KEY_COL3__GPIO3_IO30 0x110B0
		>;
	};

	pinctrl_epdc0: epdcgrp0 {
		fsl,pins = <
			MX6SL_PAD_EPDC_D0__EPDC_DATA00     0x4100b1
			MX6SL_PAD_EPDC_D1__EPDC_DATA01     0x4100b1
			MX6SL_PAD_EPDC_D2__EPDC_DATA02     0x4100b1
			MX6SL_PAD_EPDC_D3__EPDC_DATA03     0x4100b1
			MX6SL_PAD_EPDC_D4__EPDC_DATA04     0x4100b1
			MX6SL_PAD_EPDC_D5__EPDC_DATA05     0x4100b1
			MX6SL_PAD_EPDC_D6__EPDC_DATA06     0x4100b1
			MX6SL_PAD_EPDC_D7__EPDC_DATA07     0x4100b1
			MX6SL_PAD_EPDC_D8__EPDC_DATA08     0x4100b1
			MX6SL_PAD_EPDC_D9__EPDC_DATA09     0x4100b1
			MX6SL_PAD_EPDC_D10__EPDC_DATA10     0x4100b1
			MX6SL_PAD_EPDC_D11__EPDC_DATA11     0x4100b1
			MX6SL_PAD_EPDC_D12__EPDC_DATA12     0x4100b1
			MX6SL_PAD_EPDC_D13__EPDC_DATA13     0x4100b1
			MX6SL_PAD_EPDC_D14__EPDC_DATA14     0x4100b1
			MX6SL_PAD_EPDC_D15__EPDC_DATA15     0x4100b1
			MX6SL_PAD_EPDC_SDCLK__EPDC_SDCLK_P     0x4100b1
			MX6SL_PAD_EPDC_SDLE__EPDC_SDLE  0x4100b1
			MX6SL_PAD_EPDC_SDOE__EPDC_SDOE  0x4100b1
			MX6SL_PAD_EPDC_SDSHR__EPDC_SDSHR       0x4100b1
			MX6SL_PAD_EPDC_SDCE0__EPDC_SDCE0       0x4100b1
			MX6SL_PAD_EPDC_GDCLK__EPDC_GDCLK       0x4100b1
			MX6SL_PAD_EPDC_GDOE__EPDC_GDOE  0x4100b1
			MX6SL_PAD_EPDC_GDRL__EPDC_GDRL  0x4100b1
			MX6SL_PAD_EPDC_GDSP__EPDC_GDSP  0x4100b1
	       >;
	};

	pinctrl_gpio_keys: gpio-keysgrp {
		fsl,pins = <
			MX6SL_PAD_SD1_DAT1__GPIO5_IO08  0x110B0
			MX6SL_PAD_SD1_DAT4__GPIO5_IO12  0x110B0
			MX6SL_PAD_KEY_ROW0__GPIO3_IO25  0x11030
			MX6SL_PAD_KEY_ROW1__GPIO3_IO27	0x11030
			MX6SL_PAD_KEY_ROW2__GPIO3_IO29	0x11030
			MX6SL_PAD_KEY_ROW3__GPIO3_IO31	0x11030
		>;
	};

	pinctrl_hp: hpgrp {
		fsl,pins = <
			MX6SL_PAD_KEY_COL0__GPIO3_IO24	  0x1b0b0
		>;
	};

	pinctrl_i2c1: i2c1grp {
		fsl,pins = <
			MX6SL_PAD_I2C1_SCL__I2C1_SCL	 0x4001f8b1
			MX6SL_PAD_I2C1_SDA__I2C1_SDA	 0x4001f8b1
		>;
	};

